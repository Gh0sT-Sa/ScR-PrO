javascript: (function() {
    // gh0st.scr — نسخة قيد التطوير (دمج V1 + V3 عبر آلية "سلسلة احتياطية" fallback chain)
    //
    // آلية العمل: كل وظيفة مقسّمة إلى "محاولات" مرتبة بالأولوية (V1 أولاً ثم V3).
    // تُنفَّذ المحاولة الأولى، وإن لم تجد عناصر لتعمل عليها (فشل الفحص)، تُنفَّذ المحاولة التالية تلقائياً.
    // هذا يضمن عدم فقدان أي منطق من أي نسخة، ويجعل السكربت متوافقاً مع بنيات HTML مختلفة بين نسخ الشات.
    //
    // ملاحظة V2: النسخة الثانية (المُشفّرة بصيغة _0x) وصلت تالفة (رموز `[` `]` `!` استُبدلت بوسوم HTML
    // أثناء اللصق)، فلا يمكن استخراج منطقها الحقيقي بثقة. تم حجز نقاط امتداد (TODO_V2_FALLBACK) في كل
    // وظيفة أدناه لإضافة محاولتها كحلقة أخيرة في السلسلة بمجرد توفر نسخة نظيفة منها، دون كسر البنية الحالية.
    //
    // تحديث لاحق: أُضيفت ثلاث قدرات جديدة (دون حذف أي شيء) من سكربت مُدمَج ورده المستخدم:
    // استخراج ID عضو معيّن واعتراض WebSocket الحقيقي (القسم 7)، نافذة البروفايل الحديثة
    // وتتبع الغرف (القسم 8)، وربط فتح نافذة البروفايل بالمستخدمين ذوي الحالة المخفية (القسم 9).
    //
    // تحديث معماري: تحوّل السكربت إلى معمارية "تعرّف تلقائي على النسخة" (auto-detect multi-host).
    // كل نسخة شات (جوال هوست / تايقر هوست / فون هوست / يوكام هوست / هايبر هوست) أصبحت "وحدة" مستقلة
    // ضمن ScriptPro.hosts، ولا يتم تفعيل أي منطق إلا بعد التعرّف الفعلي على النسخة المطابقة لصفحة الشات
    // الحالية عبر detect()، فتُستدعى init() الخاصة بها فقط. منطق جوال هوست أدناه (وحدة jawal) هو نفس
    // المنطق الذي كان يعمل تلقائياً سابقاً، دون أي حذف أو تغيير سلوكي، فقط أصبح محصوراً داخل وحدته
    // ولا يعمل إلا بعد التعرّف على نسخة جوال هوست تحديداً. باقي النسخ (tiger/foon/ucam/hyper) محجوزة
    // كوحدات فارغة (stubs) بانتظار رفع ملفات كل نسخة لتحليلها وبناء منطقها الخاص، دون التأثير على جوال هوست.
    var ScriptPro = {
        version: '6.0.0-multi-host',
        activeHost: null,
        hosts: {}
    };

    // ============================================================
    // وحدة: شات جوال هوست (Jawal Host) — تجميع كل منطق §1..§9 الحالي داخل وحدة مستقلة
    // ============================================================
    ScriptPro.hosts.jawal = (function() {
        var jawalObserver = null;
        var jawalFlushTimer = null;
        const JAWAL_DETECTION_THRESHOLD = 4;
        var diagnostics = {
            enabled: false,
            events: [],
            maxEvents: 200
        };

        function recordDiagnostic(type, detail) {
            if (!diagnostics.enabled) return;
            diagnostics.events.push({
                time: new Date().toISOString(),
                type: type,
                detail: detail || ''
            });
            if (diagnostics.events.length > diagnostics.maxEvents) {
                diagnostics.events.shift();
            }
        }

        // كشف نسخة جوال هوست بمؤشرات متعددة لتجنب تشغيل الوحدة على نسخة أخرى.
        function detect() {
            try {
                // .uzr داخل #users هو المؤشر الأقوى (وزنه 2)، وتحتاج الوحدة
                // إلى مؤشرين داعمين على الأقل قبل التفعيل.
                var score = 0;
                if (document.querySelector('#users')) score++;
                if (document.querySelector('#users .uzr, .uzr.inroom')) score += 2;
                if (document.querySelector('.u-pic')) score++;
                if (document.querySelector('.u-topic')) score++;
                if (document.querySelector('.uhash')) score++;
                if (document.querySelector('img.ustat[src*="s4.png"]')) score++;
                return score >= JAWAL_DETECTION_THRESHOLD;
            } catch (e) {
                recordDiagnostic('detect-error', 'jawal');
                return false;
            }
        }

        // أداة استعادة Optional Chaining (?.) مع أمان كامل للمتصفحات القديمة:
        // يُحاول تجميع (compile) نسخة "حديثة" تحتوي فعلياً على صيغة ?. عبر new Function().
        // في المحركات التي لا تدعم هذه الصيغة يفشل new Function() بخطأ SyntaxError وقت
        // التجميع فقط (وليس وقت تحليل باقي السكربت، لأن الكود موجود كسلسلة نصية لم تُفسَّر
        // بعد)، فيتم التقاطه هنا بأمان والرجوع لنسخة بديلة (fallback) مكافئة تماماً في
        // السلوك مبنية بصيغة ES5 قياسية. هذا يعيد استخدام ?. فعلياً في كل محرك يدعمها،
        // مع ضمان عدم توقف تنفيذ السكربت بالكامل في أي محرك لا يدعمها.
        function compileOptionalChaining(argNames, modernBodySrc, fallbackFn) {
            try {
                return new Function(argNames.join(','), modernBodySrc);
            } catch (e) {
                return fallbackFn;
            }
        }

        // مجموعة أدوات مبنية على compileOptionalChaining، تغطي كل أنماط الاستخدام الـ13
        // التي كانت تعتمد على ?. في هذا الملف (قراءة نص/خاصية/سمة/نمط بأمان + استدعاء دالة اختيارية).
        const oc = {
            // نص عنصر فرعي (querySelector) بعد trim، أو "" إن لم يوجد
            text: compileOptionalChaining(
                ['root', 'selector'],
                'return root?.querySelector(selector)?.textContent?.trim() || "";',
                function(root, selector) {
                    const el = root && root.querySelector ? root.querySelector(selector) : null;
                    return ((el && el.textContent) ? el.textContent.trim() : "") || "";
                }
            ),
            // قيمة سمة (attribute) للعنصر نفسه بعد trim، أو "" إن لم توجد
            attr: compileOptionalChaining(
                ['el', 'name'],
                'return el?.getAttribute(name)?.trim() || "";',
                function(el, name) {
                    const v = el && el.getAttribute ? el.getAttribute(name) : null;
                    return (v ? v.trim() : "") || "";
                }
            ),
            // خاصية عنصر فرعي (مثل src) بأمان، أو "" إن لم يوجد العنصر
            prop: compileOptionalChaining(
                ['root', 'selector', 'propName'],
                'return root?.querySelector(selector)?.[propName] || "";',
                function(root, selector, propName) {
                    const el = root && root.querySelector ? root.querySelector(selector) : null;
                    return (el ? el[propName] : "") || "";
                }
            ),
            // خاصية CSS من style للعنصر الفرعي (مثل backgroundImage) بأمان
            style: compileOptionalChaining(
                ['root', 'selector', 'styleProp'],
                'return root?.querySelector(selector)?.style?.[styleProp] || "";',
                function(root, selector, styleProp) {
                    const el = root && root.querySelector ? root.querySelector(selector) : null;
                    return (el && el.style ? el.style[styleProp] : "") || "";
                }
            ),
            // خاصية متداخلة اختيارية بأمان (مثل content?.cmd)
            get: compileOptionalChaining(
                ['obj', 'key'],
                'return obj?.[key];',
                function(obj, key) {
                    return obj ? obj[key] : undefined;
                }
            ),
            // استدعاء دالة اختيارية متداخلة بأمان (مثل window.cpShowProfile?.show(...))
            call: compileOptionalChaining(
                ['obj', 'method'],
                'return obj?.[method] ? obj[method].apply(obj, Array.prototype.slice.call(arguments, 2)) : undefined;',
                function(obj, method) {
                    const fn = obj ? obj[method] : undefined;
                    return (typeof fn === 'function') ? fn.apply(obj, Array.prototype.slice.call(arguments, 2)) : undefined;
                }
            )
        };

    // أداة تنفيذ سلسلة المحاولات الاحتياطية: تُجرّب كل دالة بالترتيب حتى تُبلغ إحداها عن نجاح فعلي.
    function runFallbackChain(stageName, attempts) {
        for (let i = 0; i < attempts.length; i++) {
            try {
                const matched = attempts[i]();
                if (matched) {
                    recordDiagnostic('fallback-success', stageName + ':' + (i + 1));
                    return true;
                }
            } catch (e) {
                var errorName = e && e.name ? e.name : 'Error';
                var errorMessage = e && e.message ? String(e.message).slice(0, 120) : 'unknown';
                recordDiagnostic('fallback-error', stageName + ':' + (i + 1) + ':' + errorName + ':' + errorMessage);
            }
        }
        recordDiagnostic('fallback-empty', stageName);
        return false;
    }

    // ============================================================
    // 1) إظهار الأزرار وإزالة الإطارات المخفية
    // ============================================================
    function showUsers() {
        // محاولة V1/V3 (متطابقتان منطقياً): إظهار الأزرار وحذف عناصر itarr
        function attemptShowButtons() {
            const btns = document.querySelectorAll('.btn');
            btns.forEach(el => el.style.display = 'block');

            document.querySelectorAll('[class^="itarr"]').forEach(el => el.remove());

            if (typeof _ma56zznz2 !== 'undefined' && Array.isArray(_ma56zznz2)) {
                _ma56zznz2.forEach(obj => {
                    document.querySelectorAll(`.${obj.cls}`).forEach(el => {
                        el.classList.remove(obj.cls);
                        el.style.display = 'block';
                    });
                });
            }
            return btns.length > 0;
        }

        // محاولة إضافية (من دمج لاحق): إظهار عبر jQuery إن كان متوفراً في الصفحة
        function attemptShowButtonsJQuery() {
            if (typeof $ !== 'function') return false;
            $('.uzr').show();
            $('.btn').show();
            $('[class^="itarr"]').remove();
            return true;
        }

        // TODO_V2_FALLBACK: إضافة محاولة مكافئة من النسخة 2 هنا عند توفرها نظيفة.
        runFallbackChain('showUsers', [attemptShowButtons, attemptShowButtonsJQuery]);
    }

    // ============================================================
    // 2) حاوية التنبيهات ونظام العرض (toast)
    // ============================================================
    if (!document.getElementById("sp-jw-alert-stack")) {
        const container = document.createElement("div");
        container.id = "sp-jw-alert-stack";
        container.style = "position:fixed;top:15px;left:50%;transform:translateX(-50%);z-index:99999;max-width:320px;text-align:center";
        document.body.appendChild(container);
    }

    const alertedUsers = new Set();
    const maxVisibleAlerts = 5;

    function showAlert(user) {
        const toast = document.createElement("div");
        toast.onclick = () => toast.remove();
        toast.style = "background:#f0f0f0;border:2px solid #333;border-radius:10px;padding:10px;margin-top:10px;max-width:280px;font-family:sans-serif;color:#000;box-shadow:0 2px 6px rgba(0,0,0,.2);cursor:pointer;text-align:left";
        const title = document.createElement("div");
        title.textContent = "🔔 تنبيه";
        title.style = "font-weight:bold;text-align:center;margin-bottom:8px";
        const row = document.createElement("div");
        row.style = "display:flex;align-items:center;gap:8px";
        const pic = document.createElement("img");
        pic.src = user.pic || "pic/unknown.png";
        pic.alt = "";
        pic.style = "width:32px;height:32px;border-radius:50%;border:1px solid #ccc";
        row.appendChild(pic);
        if (user.icon) {
            const icon = document.createElement("img");
            icon.src = user.icon;
            icon.alt = "";
            icon.style = "width:16px;height:16px";
            row.appendChild(icon);
        }
        const info = document.createElement("div");
        info.style.flexGrow = "1";
        const name = document.createElement("div");
        name.textContent = user.name || "بدون اسم";
        name.style.fontWeight = "bold";
        const hash = document.createElement("div");
        hash.textContent = user.hash || "";
        hash.style = "font-size:12px;color:gray";
        info.appendChild(name);
        info.appendChild(hash);
        row.appendChild(info);
        const message = document.createElement("div");
        message.textContent = "دخل مخفي للروم";
        message.style = "margin-top:10px;padding:8px;background:#e0e0e0;border-radius:6px;text-align:center;font-weight:bold";
        toast.appendChild(title);
        toast.appendChild(row);
        toast.appendChild(message);
        const container = document.getElementById("sp-jw-alert-stack");
        if (!container) return;
        while (container.children.length >= maxVisibleAlerts) {
            container.removeChild(container.firstChild);
        }
        container.appendChild(toast);
        recordDiagnostic('hidden-user-alert', 'shown');
    }

    // ============================================================
    // 3) إظهار العناصر المخفية سابقاً
    //    hiddenSelector مُدمَج من V1 (max-height) + V3 (display: none إضافية)
    // ============================================================
    function showAllHigherRanksOnlyHidden() {
        const hiddenSelector = [
            ".uzr[style*='max-height: 0']",
            ".uzr[style*='max-height:0']",
            ".uzr[style*='display: none']" // إضافة من V3
        ].join(",");

        document.querySelectorAll(hiddenSelector).forEach(el => {
            el.setAttribute('data-sp-jw-revealed', '1');
            // اسم بديل مستخدم في النسخة المشفرة المحفوظة للتوافق مع نفس العناصر.
            el.setAttribute('data-my-hidden', '1');
        });

        const targets = document.querySelectorAll("[data-sp-jw-revealed='1'], [data-my-hidden='1']");
        if (targets.length === 0) return;

        targets.forEach(el => {
            const searchBox = document.getElementById('usearch');
            if (searchBox && searchBox.value.trim().length > 0) return;

            // محاولة V1: تصحيح classList.add لمنع إعادة إخفاء العنصر عبر __rv_me + إظهار صريح
            function attemptRevealV1() {
                if (!el._patched) {
                    const originalAdd = el.classList.add;
                    el.classList.add = function(...args) {
                        const filtered = args.filter(cls => cls !== '__rv_me');
                        return originalAdd.apply(this, filtered);
                    };
                    el._patched = true;
                }

                if (el.classList.contains('__rv_me')) {
                    el.classList.remove('__rv_me');
                }

                el.style.display = 'block';
                el.style.maxHeight = 'none';
                return true;
            }

            // محاولة V3: إعادة تعيين القيم الأصلية بدل فرض 'block'/'none' (بديل أخف تدخلاً)
            function attemptRevealV3() {
                el.style.display = '';
                el.style.maxHeight = '';
                return true;
            }

            // إن لم يظهر العنصر فعلياً بعد محاولة V1 (لا يزال بعرض/ارتفاع صفري)، جرّب أسلوب V3
            const revealedByV1 = attemptRevealV1();
            const stillHidden = window.getComputedStyle(el).display === 'none';
            if (revealedByV1 && stillHidden) {
                attemptRevealV3();
            }
            // TODO_V2_FALLBACK: إضافة محاولة إظهار مكافئة من النسخة 2 هنا عند توفرها نظيفة.

            el.querySelectorAll('[style*="display: none"]').forEach(inner => {
                inner.style.display = 'block';
            });

            const ustat = el.querySelector("img.ustat, img[src*='s0.png'], img[src*='s4.png']");
            if (ustat) ustat.src = 'imgs/s4.png';

            const nameAttr = el.getAttribute('n');
            const nameSpan = el.querySelector('.u-topic');
            if (nameSpan && nameSpan.textContent.trim() === '') {
                if (nameAttr && nameAttr.trim() !== '') {
                    nameSpan.textContent = nameAttr;
                } else {
                    const orig = nameSpan.getAttribute('data-original');
                    if (orig) nameSpan.textContent = orig;
                }
            }

            const pic = el.querySelector('.u-pic');
            if (pic) {
                const origPic = pic.getAttribute('data-original-pic');
                if (origPic) {
                    pic.style.backgroundImage = `url("${origPic}")`;
                } else {
                    const fallback = el.getAttribute('data-pic');
                    if (fallback) pic.style.backgroundImage = `url("${fallback}")`;
                }
            }
        });
    }

    // ============================================================
    // 4) إصلاح الإطارات والألوان
    //    كشف itarr_/itarr مُدمَج من V1 + V3، وإزالة الكلاسات على أوسع نطاق (ahmed/mhmood/__rv_me)
    // ============================================================
    function fixHiddenFrames() {
        document.querySelectorAll('.uzr').forEach(el => {
            const style = window.getComputedStyle(el);
            if (style.width === '0px' || style.height === '0px') {
                el.style.width = '';
                el.style.height = '';
            }

            // محاولة V1: كشف إطار بصيغة itarr_ (مع underscore)
            function attemptFrameV1() {
                const frameImg = el.querySelector('.u-pic img[class^="itarr_"]');
                if (!frameImg) return false;
                frameImg.classList.forEach(cls => {
                    if (cls.startsWith('itarr_')) {
                        const frameName = cls.replace('itarr_', '').toLowerCase();
                        if (el.classList.contains(frameName)) {
                            el.classList.remove(frameName);
                        }
                    }
                });
                return true;
            }

            // محاولة V3: كشف إطار بصيغة itarr بدون underscore (بنيات شات مختلفة)
            function attemptFrameV3() {
                const frameImg = el.querySelector('.u-pic img[class^="itarr"]');
                if (!frameImg) return false;
                frameImg.classList.forEach(cls => {
                    if (cls.startsWith('itarr')) {
                        const frameName = cls.replace('itarr', '').toLowerCase();
                        if (el.classList.contains(frameName)) {
                            el.classList.remove(frameName);
                        }
                    }
                });
                return true;
            }

            // TODO_V2_FALLBACK: إضافة محاولة كشف إطار مكافئة من النسخة 2 هنا عند توفرها نظيفة.
            runFallbackChain('fixHiddenFrames:frame', [attemptFrameV1, attemptFrameV3]);

            // إزالة الكلاسات الخاصة (اتحاد V1 الشامل: ahmed + mhmood + __rv_me، وهو أوسع من قائمة V3)
            ['ahmed', 'mhmood', '__rv_me'].forEach(cls => {
                if (el.classList.contains(cls)) {
                    el.classList.remove(cls);
                    el.style.width = '';
                    el.style.height = '';
                }
            });

            const topic = el.querySelector('.u-topic');
            if (topic) {
                const bg = window.getComputedStyle(topic).backgroundColor;
                const color = window.getComputedStyle(topic).color;
                if (bg === color) {
                    topic.style.color = '#000';
                }
            }
        });

        document.querySelectorAll(".uzr.custom-alaw").forEach(el => {
            el.classList.remove("custom-alaw");
        });
    }

    // ============================================================
    // 5) فحص المخفيين وإظهار التنبيه
    // ============================================================
    function checkHiddenUsers() {
        document.querySelectorAll('.uzr.inroom').forEach(userEl => {
            const statusImg = userEl.querySelector('img.ustat');
            if (statusImg && statusImg.src.includes('s4.png')) {
                const uidClass = [...userEl.classList].find(c => c.startsWith('uid'));
                if (uidClass && !alertedUsers.has(uidClass)) {
                    alertedUsers.add(uidClass);
                    const name = oc.attr(userEl, "n") || "بدون اسم";

                    let pic = "pic/unknown.png";
                    const picDiv = userEl.querySelector('.u-pic');
                    if (picDiv) {
                        const bg = picDiv.style.backgroundImage || window.getComputedStyle(picDiv).backgroundImage;
                        const match = bg.match(/url\(["']?(.*?)["']?\)/);
                        if (match && match[1]) {
                            pic = match[1].startsWith('http') ? match[1] : window.location.origin + '/' + match[1].replace(/^\/+/, '');
                        }
                    }
                    
                    const icon = oc.prop(userEl, '.u-ico', 'src');
                    const hash = oc.prop(userEl, '.uhash', 'textContent');
                    showAlert({
                        name,
                        pic,
                        icon,
                        hash
                    });
                }
            }
        });

        for (const uid of alertedUsers) {
            if (!document.querySelector(`.uzr.inroom.${uid} img.ustat[src*="s4.png"]`)) {
                alertedUsers.delete(uid);
            }
        }
        // TODO_V2_FALLBACK: إضافة محاولة كشف مخفيين مكافئة من النسخة 2 هنا عند توفرها نظيفة.
    }

    // ============================================================
    // 6) فتح الخاص عند الضغط على أصحاب الحالة المخفية (s4.png)
    //    موجودة فقط في V1 — لا يوجد بديل في V3، تُعتمد مباشرة.
    // ============================================================
    function enablePrivateChatOnS4() {
        document.querySelectorAll('#users .uzr').forEach(user => {
            const img = user.querySelector('img.ustat');
            if (!img || !img.getAttribute('src').includes('s4.png')) return;

            user.style.cursor = "pointer";
            if (!user._privateBound) {
                user.addEventListener("click", function(e) {
                    e.stopPropagation();
                    const uidClass = [...user.classList].find(c => c.startsWith("uid"));
                    const userId = uidClass ? uidClass.slice(3) : null;
                    if (userId && typeof openw === "function") {
                        openw(userId, true);
                        console.log("✅ تم فتح المحادثة مع:", userId);
                    } else {
                        console.warn("❌ لم يتم العثور على uid أو الدالة غير موجودة");
                    }
                });
                user._privateBound = true; // منع تكرار الحدث
            }
        });
        // TODO_V2_FALLBACK: إضافة محاولة مكافئة من النسخة 2 هنا عند توفرها نظيفة.
    }

    // ============================================================
    // 7) استخراج ID عضو معيّن واعتراض اتصال WebSocket الحقيقي
    //    (إضافة جديدة: أداة تشغَّل مرة واحدة عند التحميل بطلب نك نيم من المستخدم،
    //    ثم تحفظ الاتصال الحقيقي في window._realSocket_ عند أول رسالة صادرة تحوي الـ ID)
    // ============================================================
    function extractIdAndInterceptSocket() {
        const nick = prompt("🧠 ألصق هنا النك نيم الذي تريد استخراج الـ ID له:");
        if (!nick || nick.length < 2) {
            alert("❌ النك نيم غير صالح أو فارغ.");
            return false;
        }

        const users = document.querySelectorAll('.uzr');
        let found = false;
        let extractedId = "";

        users.forEach(div => {
            const n = div.getAttribute('n');
            if (n && n.includes(nick)) {
                const uidClass = [...div.classList].find(c => c.startsWith('uid'));
                if (uidClass) {
                    extractedId = uidClass.slice(3); // إزالة "uid"
                    found = true;
                }
            }
        });

        if (!found) {
            alert("⚠ لم يتم العثور على أي عضوية بهذا النك نيم.");
            return false;
        }

        const myId = extractedId;
        if (!window._realSocket_send_patched_) {
            const originalSend = WebSocket.prototype.send;
            WebSocket.prototype.send = function(...args) {
                const raw = args[0];
                if (typeof raw === "string" && raw.startsWith("42") && raw.includes('"msg"') && raw.includes(myId)) {
                    try {
                        const parsed = JSON.parse(raw.slice(2));
                        const [type, payload] = parsed;
                        if (type === "msg" && typeof payload === "object") {
                            const data = payload.data || {};
                            if (JSON.stringify(data).includes(myId)) {
                                window._realSocket_ = this;
                                console.log("✅ تم حفظ الاتصال الحقيقي في window._realSocket_");
                            }
                        }
                    } catch (err) {
                        console.warn("⚠ فشل في تحليل الرسالة:", raw);
                    }
                }
                return originalSend.apply(this, args);
            };
            window._realSocket_send_patched_ = true;
        }

        alert(`✅ تم استخراج الـ ID:\n${myId}\n\n📡 بدأ اعتراض WebSocket...`);
        console.log("📡 بدأ اعتراض WebSocket... بانتظار أول رسالة تحتوي على المعرف:", myId);
        return true;
    }

    // ============================================================
    // 8) نظام نافذة البروفايل الحديثة (Modal) + تتبع الغرف عبر WebSocket
    //    (إضافة جديدة: تعرض بروفايل العضو مع صورته، رسالته، غرفته الحالية،
    //    وأزرار محادثة/تنبيه/إعجاب عبر sendSocketPayload)
    // ============================================================
    function setupProfileModalSystem() {

        function showToast(t, e = 3000) {
            if (!document.getElementById("sp-jw-alert-stack")) {
                const c = document.createElement("div");
                c.id = "sp-jw-alert-stack";
                c.style = "position:fixed;top:15px;left:50%;transform:translateX(-50%);z-index:99999;max-width:320px;text-align:center";
                document.body.appendChild(c);
            }
            const o = document.createElement("div");
            o.textContent = t;
            o.style = "background:#333;color:#fff;padding:8px 12px;margin-top:8px;border-radius:8px;cursor:pointer;font-size:13px;display:inline-block;box-shadow:0 2px 6px rgba(0,0,0,.3)";
            o.onclick = () => o.remove();
            document.getElementById("sp-jw-alert-stack").appendChild(o);
            e > 0 && setTimeout(() => o.remove(), e);
        }

        function sendSocketPayload(cmd, data) {
            if (!window._realSocket_ || window._realSocket_.readyState !== 1) {
                console.warn("⚠ لا يوجد اتصال WebSocket جاهز");
                return false;
            }
            try {
                window._realSocket_.send("42" + JSON.stringify(["msg", { cmd, data }]));
                return true;
            } catch (e) {
                console.error("❌ فشل الإرسال:", e);
                return false;
            }
        }

        // 🟢 نظام تتبع الغرف
        const userRoomMap = {};
        const roomNames = {};

        function attachSocketListener(sock) {
            if (!sock || typeof sock.addEventListener !== 'function') return;
            if (sock.__profile_listener_attached) return;
            sock.__profile_listener_attached = true;

            sock.addEventListener("message", function(event) {
                try {
                    const data = event.data;
                    if (typeof data === "string" && data.startsWith("42")) {
                        const payload = JSON.parse(data.slice(2));
                        const [eventName, content] = payload;
                        if (eventName === "msg" && oc.get(content, 'cmd') === "wr" && Array.isArray(content.data)) {
                            const [userId, roomId] = content.data;
                            userRoomMap[userId] = roomId;
                            const roomEl = document.querySelector(`.room.r${roomId}`);
                            const roomName = oc.text(roomEl, ".u-topic") || undefined;
                            if (roomName) roomNames[roomId] = roomName;
                        }
                    }
                } catch (e) {
                    console.debug("⚠ تعذّر تحليل رسالة WebSocket لتتبع الغرف:", e);
                }
            });
        }

        if (window._realSocket_) {
            attachSocketListener(window._realSocket_);
        } else {
            let sAttempts = 0;
            const sMaxAttempts = 120; // ~60 ثانية كحد أقصى قبل التوقف عن الانتظار
            const sInterval = setInterval(() => {
                sAttempts++;
                if (window._realSocket_) {
                    attachSocketListener(window._realSocket_);
                    clearInterval(sInterval);
                    console.log("✅ تم ربط مستمع WebSocket بعد ظهور window._realSocket_");
                } else if (sAttempts >= sMaxAttempts) {
                    clearInterval(sInterval);
                    console.warn("⚠ لم يظهر window._realSocket_ خلال المهلة المحددة، تم إيقاف الانتظار.");
                }
            }, 500);
        }

        if (!document.getElementById("cp-showprofile-modal")) {
            const style = document.createElement("style");
            style.textContent = `
  #cp-showprofile-modal {position:fixed;z-index:100000;top:50%;left:50%;transform:translate(-50%,-50%);background:#0b4c4d;color:#fff;border-radius:6px;box-shadow:0 0 25px rgba(0,0,0,.5);width:340px;max-width:95%;font-family:Arial;overflow:hidden;display:none;}
  #cp-sp-header {background:#008c8d;color:white;padding:6px 10px;display:flex;align-items:center;justify-content:space-between;font-weight:bold;font-size:15px;}
  .modal-title {display:flex;align-items:center;gap:6px;max-width:90%;overflow:hidden;}
  #cp-user-ico {height:18px;object-fit:contain;flex-shrink:0;}
  #cp-user-banner {height:30px;object-fit:contain;flex-shrink:0;}
  #cp-user-name {font-weight:bold;font-size:15px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
  .cp-sp-close {cursor:pointer;background:none;border:none;color:#fff;font-size:18px;}
  #cp-user-pic {width:100%;height:200px;background-size:contain;background-repeat:no-repeat;background-position:50% 50%;border-bottom:1px solid rgba(255,255,255,.1);}
  #cp-user-pic-inner {width:100%;height:100%;backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);background-size:contain;background-repeat:no-repeat;background-position:50% 50%;}
  #cp-user-msg {text-align:center;padding:6px 8px;color:#ddd;border-bottom:1px solid rgba(255,255,255,.1);font-size:13px;}
  #cp-action-box {padding:10px;display:flex;gap:8px;justify-content:space-between;}
  .cp-sp-btn {flex:1;background:#17171b;border:1px solid rgba(255,255,255,.05);color:#fff;padding:10px;border-radius:6px;text-align:center;cursor:pointer;font-size:14px;}
  .cp-sp-btn:hover {background:#262629;}
  .cp-sp-btn.active {background:#1a73e8;font-weight:bold;}
  #cp-sp-notify-box {display:none;padding:10px;border-top:1px solid rgba(255,255,255,.05);}
  #cp-room-box{
  text-align: right !important;
  display: flex !important;
  justify-content: flex-end !important;
  align-items: center !important;
}
  #cp-room-box div {padding:4px 22px;background:#5c3a1e;color:#fff;border-radius:5px;font-size:12px;display:flex;align-items:center;gap:4px;cursor:pointer;}
  #cp-room-box img {max-width:24px;border-radius:4px;}
  `;
            document.head.appendChild(style);

            const modal = document.createElement("div");
            modal.id = "cp-showprofile-modal";
            modal.innerHTML = `
    <div id="cp-sp-header">
      <span class="modal-title">
        <img id="cp-user-ico">
        <img id="cp-user-banner" class="fl u-ico" alt="">
        <span id="cp-user-name"></span>
      </span>
      <button class="cp-sp-close">×</button>
    </div>
    <div id="cp-user-pic" class="fl u-pic fitimg"><div id="cp-user-pic-inner" class="bgf fl u-pic fitimg"></div></div>
    <div id="cp-user-msg"></div>
    <div id="cp-room-box"></div>
    <div id="cp-action-box">
      <div class="cp-sp-btn" id="cp-sp-private">محادثة</div>
      <div class="cp-sp-btn" id="cp-sp-notify">تنبيه</div>
      <div class="cp-sp-btn" id="cp-sp-like">إعجاب</div>
    </div>
    <div id="cp-sp-notify-box">
      <textarea id="cp-sp-notify-txt" placeholder="اكتب التنبيه هنا..." style="width:100%;height:70px;background:#0b0b0d;color:white;border-radius:6px;padding:8px;border:1px solid rgba(255,255,255,.1);"></textarea>
      <div style="display:flex;gap:8px;margin-top:8px;">
        <button class="cp-sp-small" id="cp-sp-send-not" style="flex:1;padding:8px;border-radius:6px;background:#1a73e8;border:none;color:#fff;">إرسال التنبيه</button>
        <button class="cp-sp-small secondary" id="cp-sp-cancel-not" style="flex:1;padding:8px;border-radius:6px;background:#777;border:none;color:#fff;">إلغاء</button>
      </div>
    </div>
  `;
            document.body.appendChild(modal);

            const close = modal.querySelector(".cp-sp-close"),
                like = modal.querySelector("#cp-sp-like"),
                notify = modal.querySelector("#cp-sp-notify"),
                chat = modal.querySelector("#cp-sp-private"),
                box = modal.querySelector("#cp-sp-notify-box"),
                input = modal.querySelector("#cp-sp-notify-txt"),
                send = modal.querySelector("#cp-sp-send-not"),
                cancel = modal.querySelector("#cp-sp-cancel-not"),
                userNameSpan = modal.querySelector("#cp-user-name"),
                userPic = modal.querySelector("#cp-user-pic"),
                roomMsg = modal.querySelector("#cp-user-msg"),
                icoEl = modal.querySelector("#cp-user-ico"),
                bannerEl = modal.querySelector("#cp-user-banner"),
                roomBox = modal.querySelector("#cp-room-box");

            close.onclick = () => hide();
            cancel.onclick = () => {
                input.value = "";
                hideNotify();
            };

            let target = { userId: null, username: null };

            function show(id, name, bgImg) {
                target.userId = id;
                target.username = name || "";

                const card = document.querySelector(".uid" + id);
                const topic = oc.text(card, ".u-topic") || name || id;
                userNameSpan.textContent = topic;

                // 🟢 اسم الغرفة + صورة الغرفة (بناء عبر DOM APIs بدل innerHTML لتفادي XSS)
                const roomId = userRoomMap[id];
                const roomName = roomNames[roomId] || "ليس في غرفة";
                roomBox.textContent = "";
                if (roomId) {
                    const roomEl = document.querySelector(".room.r" + roomId);
                    const roomBgRaw = oc.style(roomEl, ".u-pic", "backgroundImage");
                    const roomImg = roomBgRaw.replace(/^url\(["']?|["']?\)$/g, "").trim();

                    const roomDiv = document.createElement("div");
                    roomDiv.addEventListener("click", function() {
                        if (typeof rjoin === "function") rjoin(roomId);
                    });
                    if (roomImg) {
                        const imgEl = document.createElement("img");
                        imgEl.src = roomImg;
                        roomDiv.appendChild(imgEl);
                    }
                    roomDiv.appendChild(document.createTextNode(roomName));
                    roomBox.appendChild(roomDiv);
                } else {
                    const emptyDiv = document.createElement("div");
                    emptyDiv.style = "color:#aaa;font-size:13px;";
                    emptyDiv.textContent = "ليس في غرفة";
                    roomBox.appendChild(emptyDiv);
                }

                const ico = oc.prop(card, ".u-ico", "src");
                if (ico) bannerEl.src = ico; else bannerEl.removeAttribute("src");
                const smallIco = oc.prop(card, ".u-ico-small", "src");
                if (smallIco) icoEl.src = smallIco; else icoEl.removeAttribute("src");

                userPic.style.backgroundImage = bgImg ? `url(${bgImg})` : "none";
                const innerPic = modal.querySelector("#cp-user-pic-inner");
                if (innerPic) innerPic.style.backgroundImage = bgImg ? `url(${bgImg})` : "none";

                const msg = oc.text(card, ".u-msg");
                roomMsg.textContent = msg;

                input.value = "";
                hideNotify();
                modal.style.display = "block";
            }

            function hide() {
                modal.style.display = "none";
                target = { userId: null, username: null };
            }

            function showNotify() {
                box.style.display = "block";
            }

            function hideNotify() {
                box.style.display = "none";
            }

            like.onclick = () => {
                const id = target.userId;
                if (!id) return;
                if (sendSocketPayload("ccvimn", { cmd: "like", id })) {
                    showToast("✅ تم إرسال الإعجاب", 3000);
                    like.classList.add("active");
                    setTimeout(() => like.classList.remove("active"), 1500);
                } else {
                    showToast("❌ فشل إرسال الإعجاب", 4000);
                }
            };

            notify.onclick = () => {
                showNotify();
            };
            send.onclick = () => {
                const msg = input.value.trim(),
                    id = target.userId;
                if (!msg) return alert("اكتب نص التنبيه أولاً");
                if (sendSocketPayload("ccvimn", { cmd: "not", id, msg })) {
                    showToast("✅ تم إرسال التنبيه", 3000);
                    input.value = "";
                    hideNotify();
                    hide();
                } else {
                    alert("❌ فشل الإرسال");
                }
            };
            chat.onclick = () => {
                const id = target.userId;
                if (id) {
                    if (typeof openw === "function") {
                        openw(id, true);
                        hide();
                    } else showToast("❌ دالة openw غير موجودة");
                }
            };

            window.cpShowProfile = { show, hide };
        }
    }

    // ============================================================
    // 9) تفعيل فتح نافذة البروفايل عند الضغط على مستخدمين بحالة مخفية (s4.png)
    //    إضافة موازية للقسم (6) الذي يفتح الخاص مباشرة؛ هذه الوظيفة تفتح نافذة
    //    البروفايل بدلاً من ذلك عبر window.cpShowProfile، دون إزالة سلوك القسم (6).
    // ============================================================
    function enableProfileModalOnS4(root) {
        (root || document).querySelectorAll("div").forEach(function(el) {
            try {
                const status = el.querySelector && el.querySelector('img[src*="s4.png"]'),
                    uid = [...el.classList].find(c => c && c.startsWith && c.startsWith("uid"));
                if (status && uid && !el._profileBound) {
                    el._profileBound = true;
                    el.style.cursor = "pointer";
                    el.onclick = function() {
                        const id = uid.replace("uid", "");
                        const topic = oc.text(el, ".u-topic");
                        const rawBg = oc.style(el, ".u-pic", "backgroundImage");
                        const bgImg = rawBg.replace(/^url\(["']?|["']?\)$/g, "").trim()
                            .replace(/\.png\.png$/, ".png")
                            .replace(/\.jpg\.png$/, ".jpg")
                            .replace(/\.jpeg\.png$/, ".jpeg");
                        const profileShow = oc.get(window.cpShowProfile, "show");
                        if (profileShow) {
                            profileShow.call(window.cpShowProfile, id, topic, bgImg);
                        } else {
                            alert("نافذة شو بروفايل غير مفعّلة بعد");
                        }
                    };
                }
            } catch (e) {}
        });
    }

    // ============================================================
    // 10) إظهار أدوات نوافذ الأعضاء ومعلومات الغرفة
    //     (قدرة مستخرجة من النسخة المفكوكة في lab/last)
    // ============================================================
    function enableMemberModalControls(root) {
        (root || document).querySelectorAll('div.modal.in').forEach(modal => {
            const classes = modal.className.split(/\s+/);
            if (classes.length <= 2) return;

            [
                'span.fl.fa.btn.borderg.fa-envelope-o.unot',
                'span.fl.fa.btn.borderg.fa-comment.upm',
                'span.fl.fa.btn.borderg.fa-heart.ulike',
                'span.fl.fa.btn.borderg.fa-ban.udelpic'
            ].forEach(selector => {
                modal.querySelectorAll(selector).forEach(control => {
                    control.style.setProperty('visibility', 'visible', 'important');
                    control.style.setProperty('display', 'inline-block', 'important');
                    control.style.setProperty('opacity', '1', 'important');
                });
            });

            modal.querySelectorAll('.u-room, .roomh').forEach(roomElement => {
                const roomText = roomElement.textContent.trim();
                if (roomText !== '' && !roomText.includes('undefined')) {
                    roomElement.style.setProperty('visibility', 'visible', 'important');
                    roomElement.style.setProperty('display', 'block', 'important');
                    roomElement.style.setProperty('opacity', '1', 'important');
                } else {
                    roomElement.style.setProperty('display', 'none', 'important');
                }
            });
        });
    }

    // ============================================================
    // 11) مراقبة DOM — تُفعِّل كل ما سبق تلقائياً عند أي تغيير بالصفحة
    // ============================================================
    // يمنح التحديثات المتتابعة مهلة قصيرة للتجمع قبل إعادة فحص الواجهة.
    const JAWAL_FLUSH_DELAY_MS = 50;
    function runAllStages() {
        showUsers();
        showAllHigherRanksOnlyHidden();
        fixHiddenFrames();
        checkHiddenUsers();
        enablePrivateChatOnS4();
        enableProfileModalOnS4();
        enableMemberModalControls();
    }

    function scheduleRunAllStages() {
        if (jawalFlushTimer !== null) clearTimeout(jawalFlushTimer);
        jawalFlushTimer = setTimeout(function() {
            jawalFlushTimer = null;
            runAllStages();
        }, JAWAL_FLUSH_DELAY_MS);
    }

    function enableDiagnostics() {
        diagnostics.enabled = true;
        recordDiagnostic('diagnostics-enabled', 'dom-and-local-state-metadata-only');
        return true;
    }

    function disableDiagnostics() {
        diagnostics.enabled = false;
        return true;
    }

    function getDiagnostics() {
        return diagnostics.events.slice();
    }

    function destroy() {
        if (jawalObserver) {
            jawalObserver.disconnect();
            jawalObserver = null;
        }
        if (jawalFlushTimer !== null) {
            clearTimeout(jawalFlushTimer);
            jawalFlushTimer = null;
        }
        alertedUsers.clear();
        disableDiagnostics();
        if (window.ScriptPro && window.ScriptPro.activeHost === 'jawal') {
            window.ScriptPro.activeHost = null;
        }
    }

    function init() {
        // إنشاء نافذة البروفايل الحديثة مرة واحدة فقط عند تفعيل هذه الوحدة تحديداً
        try {
            setupProfileModalSystem();
        } catch (e) {
            console.warn('⚠️ فشل تهيئة نظام نافذة البروفايل:', e);
        }

        if (typeof MutationObserver === 'function' && !jawalObserver) {
            jawalObserver = new MutationObserver(function(records) {
                const searchBox = document.getElementById('usearch');
                if (searchBox && searchBox.value.trim().length > 0) return;
                if (diagnostics.enabled) {
                    var firstTarget = records && records[0] && records[0].target;
                    var targetName = firstTarget && firstTarget.nodeName ? firstTarget.nodeName : 'body';
                    recordDiagnostic('dom-change', String(records ? records.length : 0) + ':' + targetName);
                }
                scheduleRunAllStages();
            });
            // تُراقب body لأن نافذة البروفايل والتنبيهات قد تكون خارج #users.
            jawalObserver.observe(document.body, {
                childList: true,
                subtree: true
            });
        }

        // تشغيل أولي
        runAllStages();

        console.log("✅ تم التفعيل [Jawal Host]: إظهار الأزرار + المخفيين + إصلاح جميع الإطارات والألوان (بما فيها ahmed + mhmood) + تنبيه + فتح الخاص عند الضغط على أصحاب s4.png + نافذة البروفايل الحديثة + تتبع الغرف [دمج V1+V3 بسلسلة احتياطية + إضافات جديدة]");

        // استخراج ID عضو معيّن واعتراض WebSocket الحقيقي (القسم 7): أداة تفاعلية تُظهر
        // نافذة prompt() لذلك لا تُستدعى تلقائياً هنا (لتفادي حظر الصفحة بها في كل تفعيل
        // للسكربت أو عند كل تشغيل لـ MutationObserver). تبقى متاحة للاستدعاء اليدوي
        // عند الحاجة عبر console: extractIdAndInterceptSocket()
        window.extractIdAndInterceptSocket = extractIdAndInterceptSocket;
        if (window.__SCRIPTPRO_ENABLE_DIAGNOSTICS__ === true) {
            window.ScriptProJawalDiagnostics = {
                enable: enableDiagnostics,
                disable: disableDiagnostics,
                getEvents: getDiagnostics,
                destroy: destroy
            };
        }
    }

    return {
        name: 'شات جوال هوست (Jawal Host)',
        detect: detect,
        init: init,
        destroy: destroy,
        enableDiagnostics: enableDiagnostics,
        disableDiagnostics: disableDiagnostics,
        getDiagnostics: getDiagnostics
    };
    })();

    // ============================================================
    // وحدات محجوزة (Stubs) لبقية النسخ — بانتظار رفع ملفات كل نسخة لتحليلها
    // (شات هايبر هوست، شات تايقر هوست، شات يوكام هوست، شات فون هوست)
    // كل وحدة detect() ترجع false حالياً حتى لا تتعارض مع جوال هوست أو تعمل خطأً على نسخة غير مدعومة بعد.
    // بمجرد رفع ملفات إحدى هذه النسخ في samples/<host>، تُحلَّل وتُبنى detect()/init() الخاصة بها هنا
    // دون أي تعديل على وحدة جوال هوست أعلاه.
    // ============================================================
    function makePendingHostModule(hostName) {
        return {
            name: hostName,
            detect: function() { return false; },
            init: function() {
                console.log('⏳ [' + hostName + '] لم يتم رفع ورصد ملفات هذه النسخة بعد لبناء منطقها.');
            }
        };
    }
    ScriptPro.hosts.tiger = makePendingHostModule('شات تايقر هوست (Tiger Host)');
    ScriptPro.hosts.foon = makePendingHostModule('شات فون هوست (Foon Host)');
    ScriptPro.hosts.ucam = makePendingHostModule('شات يوكام هوست (Ucam Host)');
    ScriptPro.hosts.hyper = makePendingHostModule('شات هايبر هوست (Hyper Host)');

    // ============================================================
    // نقطة الدخول: تعرّف تلقائي على نسخة الشات الحالية، ثم تفعيل وحدتها فقط
    // ترتيب الفحص: جوال هوست (مكتملة) ثم البقية (محجوزة حالياً)
    // ============================================================
    function detectAndActivate() {
        var order = ['jawal', 'tiger', 'foon', 'ucam', 'hyper'];
        for (var i = 0; i < order.length; i++) {
            var key = order[i];
            var host = ScriptPro.hosts[key];
            if (!host || typeof host.detect !== 'function') continue;
            try {
                if (host.detect()) {
                    ScriptPro.activeHost = key;
                    console.log('🔎 تم التعرف على النسخة: ' + host.name);
                    host.init();
                    return true;
                }
            } catch (e) {
                console.warn('⚠️ فشل فحص/تفعيل وحدة "' + (host && host.name) + '":', e);
            }
        }
        console.warn('⚠️ لم يتم التعرف على أي نسخة مدعومة حالياً على هذه الصفحة.');
        return false;
    }

    window.ScriptPro = ScriptPro;
    detectAndActivate();
})();
