      border:1px solid #00ff88;
    }

    .banner-menu-box .f-btn:nth-child(4):hover{
      color:#ff2bd6;
      box-shadow:0 0 5px #ff2bd6,0 0 15px #ff2bd6,0 0 30px #ff2bd6;
      border:1px solid #ff2bd6;
    }

    .banner-menu-box .f-btn:nth-child(5):hover{
      color:#ffd400;
      box-shadow:0 0 5px #ffd400,0 0 15px #ffd400,0 0 30px #ffd400;
      border:1px solid #ffd400;
    }

    .banner-menu-box .f-btn:nth-child(6):hover{
      color:#00eaff;
      box-shadow:0 0 5px #00eaff,0 0 15px #00eaff,0 0 30px #00eaff;
      border:1px solid #00eaff;
    }

    .banner-menu-box .f-btn:nth-child(7):hover{
