      box-shadow:0 0 5px #4d7dff,0 0 15px #4d7dff,0 0 30px #4d7dff;
      border:1px solid #4d7dff;
    }

    .status-dot{
      display:inline-block;
      width:10px;
      height:10px;
      border-radius:50%;
      margin:0 2px;
      vertical-align:middle;
      box-shadow:0 0 6px currentColor;
    }

    .status-dot.green{ background:#00ff66; color:#00ff66; }
    .status-dot.red{ background:#ff3030; color:#ff3030; }
    .status-dot.yellow{ background:#ffd400; color:#ffd400; }
    .status-dot.gray{ background:#aaa; color:#aaa; }
    .status-dot.cyan{ background:#00eaff; color:#00eaff; }

    .banner-menu-back{
      margin-top:10px;
      width:100%;
      padding:8px;
      border:none;
      border-radius:10px;
      background:#111;
      color:#fff;
      cursor:pointer;
      font-weight:700;
    }

    .menu-close{
      margin-top:10px;
      width:100%;
      padding:8px;
      border:none;
      border-radius:10px;
      background:#111;
      color:#fff;
      cursor:pointer;
    }

    .banner-change{
      position:relative;
      overflow:hidden;
    }

    .banner-upload-bar{
      position:absolute;
      bottom:0;
      left:0;
      height:3px;
      width:0%;
      background:#9b5cff;
      box-shadow:0 0 6px #9b5cff;
      transition:width .2s ease;
      pointer-events:none;
    }

    .bprofile-change{
      position:relative;
      overflow:hidden;
    }

    .bprofile-upload-bar{
      position:absolute;
      bottom:0;
      left:0;
      height:3px;
      width:0%;
      background:#00ff88;
      box-shadow:0 0 6px #00ff88;
      transition:width .2s ease;
      pointer-events:none;
    }
