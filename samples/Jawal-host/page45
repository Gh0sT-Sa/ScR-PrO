    #unique-features-btn{
      position: relative;
      overflow: hidden;
      background: linear-gradient(135deg,#111,#222,#000);
      color:#fff !important;
      margin: 2px 4px !important;
      padding: 8px 10px !important;
      width: 98% !important;
      display: inline-block !important;
      box-sizing: border-box !important;
      border: 1px solid #444 !important;
      border-radius: 6px !important;
      text-align: center !important;
      font-size: 14px !important;
      line-height: 1.4 !important;
      cursor: pointer;
      transition: .2s;
      font-weight: 700;

    }

    #unique-features-btn::after{
      content:"";
      position:absolute;
      top:0;
      left:-120%;
      width:80%;
      height:100%;
      background: linear-gradient(120deg,transparent,rgba(255,215,0,0.6),transparent);
      transform: skewX(-20deg);
      animation: goldShine 3s ease-in-out infinite;
    }

    @keyframes goldShine{
      0%{ left:-120%; }
      50%{ left:120%; }
      100%{ left:120%; }
    }

    #unique-features-btn:hover{
      box-shadow:0 0 12px gold;
    }

    #features-menu{
      position:fixed;
      inset:0;
      z-index:999999;
      opacity:0;
      visibility:hidden;
      transition:.2s;
    }

    #features-menu.active{
      opacity:1;
      visibility:visible;
    }

    .menu-overlay{
      position:absolute;
      inset:0;
      background:rgba(0,0,0,.6);
      backdrop-filter:blur(10px);
    }

    .menu-box{
      position:absolute;
      top:50%;
      left:50%;
      transform:translate(-50%,-50%);
      width:320px;
      background:linear-gradient(145deg,#0f0f0f,#1a1a1a);
      border-radius:20px;
      padding:20px;
      box-shadow:0 20px 60px rgba(0,0,0,.7);
      text-align:center;
    }

    .menu-title{
      color:gold;
      font-weight:900;
      margin-bottom:15px;
      font-size:16px;
    }

    .ghost-btn,
    .ghost-room-btn{
      display:none;
    }

    .f-btn{
      width:100%;
      margin:6px 0;
      padding:10px;
      border:none;
      border-radius:12px;
      background:#0a0a0a;
      color:#fff;
      font-weight:700;
      cursor:pointer;
      transition:.25s;
    }

    .f-btn:hover{
      transform:translateY(-1px);
    }

    .menu-box .f-btn:nth-child(2):hover{
      color:#00eaff;
      box-shadow:0 0 5px #00eaff,0 0 15px #00eaff,0 0 30px #00eaff;
      border:1px solid #00eaff;
    }

    .menu-box .f-btn:nth-child(3):hover{
      color:#ff2bd6;
      box-shadow:0 0 5px #ff2bd6,0 0 15px #ff2bd6,0 0 30px #ff2bd6;
      border:1px solid #ff2bd6;
    }

    .menu-box .f-btn:nth-child(4):hover{
      color:#9b5cff;
      box-shadow:0 0 5px #9b5cff,0 0 15px #9b5cff,0 0 30px #9b5cff;
      border:1px solid #9b5cff;
    }

    .menu-box .f-btn:nth-child(5):hover{
      color:#00ff88;
      box-shadow:0 0 5px #00ff88,0 0 15px #00ff88,0 0 30px #00ff88;
      border:1px solid #00ff88;
    }

    #membership-banner-menu{
      position:fixed;
      inset:0;
      z-index:1000000;
      opacity:0;
      visibility:hidden;
      transition:.2s;
    }

    #membership-banner-menu.active{
      opacity:1;
      visibility:visible;
    }

    .banner-menu-overlay{
      position:absolute;
      inset:0;
      background:rgba(0,0,0,.65);
      backdrop-filter:blur(10px);
    }

    .banner-menu-box{
      position:absolute;
      top:50%;
      left:50%;
      transform:translate(-50%,-50%);
      width:300px;
      background:linear-gradient(145deg,#111,#1c1c1c);
      border-radius:18px;
      padding:18px;
      box-shadow:0 20px 60px rgba(0,0,0,.75);
      text-align:center;
      border:1px solid #333;
    }

    .banner-menu-title{
      color:#9b5cff;
      font-weight:900;
      margin-bottom:12px;
      font-size:16px;
    }

    .banner-menu-box .f-btn:nth-child(2):hover{
      color:#9b5cff;
      box-shadow:0 0 5px #9b5cff,0 0 15px #9b5cff,0 0 30px #9b5cff;
      border:1px solid #9b5cff;
    }

    .banner-menu-box .f-btn:nth-child(3):hover{
